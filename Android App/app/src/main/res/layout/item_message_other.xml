<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="start"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMessageSenderOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="alice"
            android:textColor="@color/slate_300"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMessageTimeOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="10:45 AM"
            android:textColor="@color/slate_500"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_other"
        android:maxWidth="280dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvMessageContentOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello from the other side!"
            android:textColor="@color/slate_100"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Seen by member's list -->
    <TextView
        android:id="@+id/tvSeenByOther"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:text="Seen by bob"
        android:textColor="@color/slate_400"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
